page { background: #f4f8f7; color: #203c36; font-size: 16px; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
.container { max-width: 900rpx; margin: auto; padding: 36rpx 30rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.title { font-size: 48rpx; font-weight: 700; margin: 12rpx 0 20rpx; }
.subtitle, .muted { color: #5c746d; line-height: 1.7; }
.card { background: #fff; border-radius: 24rpx; padding: 30rpx; margin: 24rpx 0; border: 1rpx solid #e3eeea; }
.card-title { font-size: 36rpx; font-weight: 600; margin-bottom: 20rpx; }
button { min-height: 44px; line-height: 1.5; padding: 24rpx; margin-top: 20rpx; border-radius: 18rpx; font-size: 16px; }
button::after { border: 0; }
.primary { color: white; background: #176e65; }
.secondary { color: #176e65; background: #e9f4f0; }
.danger { color: #a53c35; background: #fff1ee; }
input, textarea, .picker { box-sizing: border-box; width: 100%; min-height: 44px; background: #f4f8f7; border-radius: 14rpx; padding: 24rpx; margin: 12rpx 0 24rpx; font-size: 16px; }
.label { font-weight: 500; margin-top: 20rpx; }
.row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx; margin: 18rpx 0; }
.pill { background: #eef5f2; border-radius: 14rpx; padding: 10rpx 20rpx; font-size: 14px; }
.error { background: #fff1ee; color: #9e342e; padding: 24rpx; border-radius: 16rpx; line-height: 1.7; }
.empty { padding: 28rpx 0; color: #5c746d; line-height: 1.8; }
.code { font-family: monospace; letter-spacing: 4rpx; font-size: 42rpx; overflow-wrap: anywhere; }
.small { font-size: 14px; }
